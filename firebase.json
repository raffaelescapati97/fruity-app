{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist/fruity-app/browser",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "fruitApi", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}